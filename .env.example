# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=FiberStarter
APP_ENV=local
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8080
APP_HTTP_PORT=3300
APP_TIMEZONE=Asia/Shanghai
APP_URL=http://localhost:3300
CONFIG_WARN_MISSING_ENV_FILE=false

# Fiber
APP_FIBER_PREFORK=false
APP_FIBER_SERVER_HEADER=
APP_FIBER_BODY_LIMIT=4194304
APP_FIBER_CONCURRENCY=262144
APP_FIBER_READ_BUFFER_SIZE=16384
APP_FIBER_READ_TIMEOUT=30
APP_FIBER_WRITE_TIMEOUT=30
APP_FIBER_IDLE_TIMEOUT=120
APP_FIBER_TRUST_PROXY=false
APP_FIBER_PROXY_HEADER=X-Forwarded-For
APP_FIBER_STREAM_REQUEST_BODY=false
APP_FIBER_IMMUTABLE=false

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fiber_starter
DB_USERNAME=postgres
DB_PASSWORD=
DB_CHARSET=utf8
DB_SCHEMA=public
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Shanghai
DB_POOL_MAX_OPEN_CONNS=100
DB_POOL_MAX_IDLE_CONNS=10
DB_POOL_CONN_MAX_LIFETIME=3600
DB_POOL_CONN_MAX_IDLE_TIME=600

# -----------------------------------------------------------------------------
# Redis / Cache / Queue / Realtime
# -----------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

CACHE_STORE=redis
CACHE_DRIVER=redis
CACHE_PREFIX=fiber_starter:
CACHE_TTL=3600

QUEUE_CONNECTION=redis
QUEUE_CONCURRENCY=10

WEBSOCKET_BUS_MODE=redis
WEBSOCKET_REDIS_PREFIX=realtime
WEBSOCKET_PORT=3001
WEBSOCKET_PATH=/ws
WEBSOCKET_AUTH_PATH=/broadcasting/auth
WEBSOCKET_HEARTBEAT_INTERVAL=30

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
JWT_SECRET=change-me
JWT_EXPIRATION_TIME=3600
JWT_REFRESH_TIME=604800
JWT_ISSUER=fiber-starter

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_FROM_NAME=Fiber Starter
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_REPLY_TO=
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# Filesystem / Object Storage
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=garage
STORAGE_DRIVER=garage

GARAGE_ENDPOINT=localhost:3900
GARAGE_ACCESS_KEY_ID=
GARAGE_SECRET_ACCESS_KEY=
GARAGE_USE_SSL=false
GARAGE_BUCKET=fiber-starter
GARAGE_REGION=us-east-1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=fiber-starter
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

STORAGE_LOCAL_ROOT=./storage/app
STORAGE_LOCAL_URL=/storage
STORAGE_PUBLIC_ROOT=./storage/app/public
STORAGE_PUBLIC_URL=/storage

# -----------------------------------------------------------------------------
# Search
# -----------------------------------------------------------------------------
SEARCH_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_API_KEY=

# -----------------------------------------------------------------------------
# Logging / Observability
# -----------------------------------------------------------------------------
LOGGER_LEVEL=info
LOGGER_FORMAT=json
LOGGER_OUTPUT=stack
LOGGER_MAX_SIZE=100
LOGGER_MAX_AGE=30
LOGGER_MAX_BACKUPS=10
LOGGER_COMPRESS=true

OTEL_ENABLED=false
OTEL_SERVICE_NAME=fiber-starter
OTEL_EXPORTER_TYPE=stdout
OTEL_ENDPOINT=localhost:4317

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
SECURITY_CORS_ALLOWED_ORIGINS=*
SECURITY_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
SECURITY_CORS_ALLOWED_HEADERS=*
SECURITY_RATE_LIMIT_MAX=1000
SECURITY_RATE_LIMIT_WINDOW=60
SECURITY_LOAD_SHED_ENABLED=false
SECURITY_LOAD_SHED_LOWER=0.85
SECURITY_LOAD_SHED_UPPER=0.95

# -----------------------------------------------------------------------------
# i18n
# -----------------------------------------------------------------------------
I18N_ENABLED=true
I18N_DEFAULT_LANGUAGE=zh-CN
I18N_SUPPORTED_LANGUAGES=en,zh-CN
I18N_LANGUAGE_DIR=./lang
I18N_COOKIE_NAME=lang
I18N_COOKIE_MAX_AGE=31536000

# -----------------------------------------------------------------------------
# Business
# -----------------------------------------------------------------------------
ORDER_PAYMENT_TIMEOUT=30
ORDER_PICKUP_TIMEOUT=1440
DEVICE_CHANNEL_COUNT=53
DEVICE_CHANNEL_MAX_CAPACITY=4
