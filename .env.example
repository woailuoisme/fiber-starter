APP_NAME="lfiber"
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:3000
APP_PORT=3000
APP_TIMEZONE=Asia/Shanghai
APP_LOCALE=en

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lfiber
DB_USERNAME=postgres
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------------------------------------------
# Cache
# -----------------------------------------------------------------------------
CACHE_STORE=redis

# -----------------------------------------------------------------------------
# Queue
# -----------------------------------------------------------------------------
QUEUE_CONNECTION=redis

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=none
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Filesystem / Storage
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=

# -----------------------------------------------------------------------------
# Auth / JWT
# -----------------------------------------------------------------------------
# Required in non-local environments. Generate with: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION_TIME=3600
JWT_REFRESH_TIME=604800
AUTHORIZATION_MODEL_FILE=configs/casbin/model.conf
AUTHORIZATION_POLICY_FILE=configs/casbin/policy.csv

# -----------------------------------------------------------------------------
# Search
# -----------------------------------------------------------------------------
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=

# -----------------------------------------------------------------------------
# Dependency Criticality
# -----------------------------------------------------------------------------
SERVICE_DATABASE_CRITICAL=true
SERVICE_CACHE_CRITICAL=false
SERVICE_STORAGE_CRITICAL=false
SERVICE_MAIL_CRITICAL=false
SERVICE_QUEUE_CRITICAL=false
SERVICE_SEARCH_CRITICAL=false
SERVICE_REALTIME_CRITICAL=false

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOGGER_OUTPUT=stack
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Realtime (WebSocket)
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=redis
WEBSOCKET_PORT=6001
WEBSOCKET_PATH=/app/:appKey
REVERB_APP_ID=lfiber
REVERB_APP_KEY=lfiber
REVERB_APP_SECRET=

# -----------------------------------------------------------------------------
# Observability (OpenTelemetry)
# -----------------------------------------------------------------------------
# 是否开启 OpenTelemetry 链路追踪 (Tracer 引擎)
OTEL_TRACE_ENABLED=false
OTEL_SERVICE_NAME="${APP_NAME}"
# exporter_type 可选值：
#   stdout  - 将追踪和指标输出到控制台（开发调试用）
#   otlp    - 通过 gRPC 推送到 OpenTelemetry Collector（生产推荐）
OTEL_EXPORTER_TYPE=stdout
OTEL_ENDPOINT=localhost:4317
OTEL_OTLP_INSECURE=true
OTEL_TRACE_SAMPLE_RATIO=1.0
# 是否开启 Prometheus 指标暴露（/metrics 抓取端点）
OTEL_METRICS_ENABLED=false
OTEL_METRICS_PATH=/metrics

# -----------------------------------------------------------------------------
# Security / Resilience (Rate Limit, Load Shed, Circuit Breaker)
# -----------------------------------------------------------------------------
RATE_LIMIT_MAX=1000
CIRCUIT_BREAKER_ENABLED=false
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=10
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=5
CIRCUIT_BREAKER_HALF_OPEN_MAX_CONCURRENT=1

LOG_VIEWER_ENABLED=false
LOG_VIEWER_PATH=storage/logs
LOG_VIEWER_USERNAME=
LOG_VIEWER_PASSWORD=
LOG_VIEWER_ALLOW_DELETE=false
