{{ define "panel" }}
<table class="panel" width="100%" cellpadding="0" cellspacing="0" role="presentation" style="box-sizing: border-box; margin: 25px 0; width: 100%;">
    <tr>
        <td style="box-sizing: border-box; background-color: {{$.Theme.BgColor}}; border-left: 4px solid {{ if eq .Color "success" }}{{$.Theme.SuccessColor}}{{ else if eq .Color "danger" }}{{$.Theme.DangerColor}}{{ else if eq .Color "warning" }}{{$.Theme.WarningColor}}{{ else }}{{$.Theme.PrimaryColor}}{{ end }}; padding: 16px; border-radius: 0 6px 6px 0;">
            <p style="box-sizing: border-box; color: #475569; font-size: 14px; line-height: 1.6; margin: 0;">
                {{ .Text }}
            </p>
        </td>
    </tr>
</table>
{{ end }}
