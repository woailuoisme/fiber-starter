# ==========================================
# Go lfiber Project - .gitignore
# ==========================================

# ------------------------------------------
# Binaries & Execution
# ------------------------------------------
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
debug
debug.test
__debug_bin
/bin/
/lfiber
/lfiber-cli
/main

# ------------------------------------------
# OS Generated Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ------------------------------------------
# IDEs, Editors & Tooling
# ------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
*.iml
.project
.settings/

# ------------------------------------------
# Environment & Secrets (SECURITY)
# ------------------------------------------
.env
.env.*
.env*
!.env.example
secrets.ini
*.pem
*.key
*.cert

# ------------------------------------------
# Dependencies & Workspaces
# ------------------------------------------
/vendor/
go.work
go.work.sum

# ------------------------------------------
# Logs
# ------------------------------------------
*.log
/logs/
/storage/logs/

# ------------------------------------------
# Databases
# ------------------------------------------
*.db
*.sqlite
*.sqlite3
*.sqlite3-journal

# ------------------------------------------
# Caches & Temporary Files
# ------------------------------------------
/tmp/
.temp/
.cache/
.gocache/
.gopath/
.go/
.golangci-lint-cache/
.playwright-cli/

# ------------------------------------------
# Build & Distribution Outputs
# ------------------------------------------
/dist/
/build/

# ------------------------------------------
# Testing & Coverage
# ------------------------------------------
coverage.txt
coverage.html
coverage.out
coverage.xml
/coverage/
/tests/coverage/
/test-results/
/.test-results/

# ------------------------------------------
# Infrastructure & Deployment
# ------------------------------------------
*.tfstate
*.tfstate.*
.terraform/
*.kubeconfig

# ------------------------------------------
# Framework Storage (Laravel Style)
# ------------------------------------------
/storage/app/public/*
!/storage/app/public/.gitkeep
/storage/framework/cache/*
!/storage/framework/cache/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep
/storage/framework/testing/*
!/storage/framework/testing/.gitkeep

# ------------------------------------------
# Local Development
# ------------------------------------------
.local/
.mise.local.toml

# ------------------------------------------
# AI & Agent Tools
# ------------------------------------------
.claude
.gemini
.trae
.kiro
/specs/

# .agents (Selectively allow certain skills)
!.agents/
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/bun-orm/

.cursor
.antigravitycli

# .specify (Selectively allow memory configuration)
!.specify/
.specify/*
!.specify/memory/
.specify/memory/*
!.specify/memory/constitution.md
# Added by code-review-graph
.code-review-graph/
.codegraph
