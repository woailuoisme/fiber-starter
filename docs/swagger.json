        ],
        "tags": [
          "认证中心"
        ],
        "summary": "修改密码",
        "parameters": [
          {
            "description": "修改参数",
            "name": "request",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ChangePasswordRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "修改成功",
            "schema": {
              "$ref": "#/definitions/APIResponse"
            }
          }
        }
      }
    },
